apiVersion: apps/v1
kind: Deployment
metadata:
  name: create-importers
  namespace: "{{ tpa_single_node_namespace }}"
  labels:
    app: create-importers
    app.kubernetes.io/version: 2.2.1
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: create-importers
  template:
    metadata:
      labels:
        app: create-importers
    spec:
      restartPolicy: OnFailure
      containers:
        - name: run
          image: "{{ tpa_single_node_trustification_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: PGHOST
              value: "{{ tpa_single_node_pg_host }}"
            - name: PGPORT
              value: "{{ tpa_single_node_pg_port }}"
            - name: PGDATABASE
              value: "{{ tpa_single_node_pg_db }}"
            - name: PGUSER
              value: "{{ tpa_single_node_pg_user }}"
            - name: PGPASSWORD
              value: "{{  tpa_single_node_pg_user_passwd }}"
            - name: PGSSLMODE
              value: {{ tpa_single_node_pg_ssl_mode }}
          command:
            - psql
            - -v
            - ON_ERROR_STOP=1
            - -f
            - /etc/importers/importers.sql
          volumeMounts:
            - mountPath: /etc/importers
              name: create-importers
      volumes:
        - name: create-importers
          configMap:
            name: create-importers

